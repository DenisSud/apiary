# Radicale rights — who may touch what.
#
# Sections are matched in order; the first match wins.
#
#   denis  — owns his own home and everything below it
#   agent  — read/write on /denis/main/ only: the one shared calendar
#
# The agent has no access to any other collection, and no user can reach
# another user's home.
#
# Permissions are case-sensitive (Radicale's own quirk): lowercase `rw` is
# access to the *items* in a collection (events), uppercase `RW` is access to
# the collection itself (creating/deleting it, its properties). MKCALENDAR
# checks the lowercase `w` on the new path, so `rw` is what makes a calendar
# usable.

[denis-own]
user: denis
collection: denis(/.*)?
permissions: RWrw

[agent-main]
user: agent
collection: denis/main(/.*)?
permissions: rw

# Authenticated users may read the root collection (needed for
# /.well-known/caldav discovery by GNOME Calendar and phones).
[root-read]
user: .+
collection:
permissions: R
