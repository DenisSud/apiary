#!/usr/bin/env sh
# apiary-web — web bridge for the bots.
#
# Serves the bot list and relays browser WebSockets to the bots' unix sockets.
# See packages/connector/README.md for the bridge contract.
set -eu

self="$(readlink -f "$0")"
root="$(cd "$(dirname "$self")/../../.." && pwd)"
exec node "$root/packages/connector/src/web-cli.ts" "$@"
